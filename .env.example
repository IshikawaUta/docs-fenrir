# Fenrir Documentation Environment Variables

# Development mode (set to 1 to enable debug pages)
FENRIR_DEV=0

# Sentry Error Monitoring (optional)
# SENTRY_DSN=https://your-sentry-dsn

# Monitoring Dashboard (optional)
MONITORING_ENABLED=false
MONITORING_USER=admin
MONITORING_PASSWORD=changeme
MONITORING_SECRET_KEY=generate-a-random-secret-key
MONITORING_SITES=http://localhost:8000
MONITORING_CHECK_INTERVAL=60